---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatBand from '../../components/StatBand.astro';
import Timeline from '../../components/Timeline.astro';
import Section from '../../components/Section.astro';
import Videos from '../../components/Videos.astro';
import Awards from '../../components/Awards.astro';
import Press from '../../components/Press.astro';
import Cards from '../../components/Cards.astro';
import Card from '../../components/Card.astro';
import Figure from '../../components/Figure.astro';
import { locales, type Locale } from '../../i18n/ui';
import { useTranslations, localePath } from '../../i18n/utils';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
// 홈 원고의 id는 언어 코드 그대로다 (glob 로더가 index.mdx의 'index'를 뗀다).
const entry = await getEntry('pages', locale);
if (!entry) throw new Error(`src/content/${locale}/index.mdx가 없습니다`);
const { Content } = await render(entry);
// 첫 화면 문구는 frontmatter의 hero에 있다. 없으면 title·description으로 대신한다.
const hero = entry.data.hero;
// 첫 화면 배경은 정조 화성행궁 행렬 콘텐츠(media10)의 앞 6초를 잘라 만든 무음 클립이다 (public/video/).
// 움직임을 줄이도록 설정한 방문자에게는 정지 이미지(같은 이름의 jpg)만 보인다 (DESIGN.md 5절 규칙 4).
const heroClip = withBase('/video/hero-hwaseong.mp4');
const heroStill = withBase('/video/hero-hwaseong.jpg');
---

<BaseLayout description={entry.data.description} stub={entry.data.stub} draft={entry.data.draft}>
  <section class="hero">
    <div class="bg" aria-hidden="true">
      <video muted loop playsinline preload="none" poster={heroStill} src={heroClip}></video>
    </div>
    <div class="wrap">
      <p class="label">{t('hero.eyebrow')}</p>
      <h1>{hero?.heading ?? entry.data.title}</h1>
      <p class="lead measure">{hero?.lead ?? entry.data.description}</p>
      {hero && hero.facts.length > 0 && (
        <ul class="facts measure">
          {hero.facts.map((f) => <li>{f}</li>)}
        </ul>
      )}
      <p class="actions">
        <a class="btn btn-primary" href={localePath(locale, '/much/outcomes/')}>{t('hero.cta.outcomes')}</a>
        <a class="btn" href={localePath(locale, '/much/')}>{t('hero.cta.much')}</a>
      </p>
    </div>
  </section>

  <StatBand />

  {/* 홈 본문(MDX)은 산문 대신 구성 요소만 쌓는다. 태그 이름은 여기서 넘긴 것만 쓸 수 있다. */}
  <Content components={{ Section, Videos, Awards, Press, Cards, Card, Figure }} />

  <Timeline />
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: var(--section-pad); padding-bottom: 72px; }
  .hero .wrap { position: relative; }
  /* 배경 영상은 글자 뒤에서 흐리게 깔린다. 왼쪽 절반은 바탕색으로 덮어 글자 대비를 지키고, 아래는 다음 띠로 잦아든다. */
  .bg { position: absolute; inset: 0; }
  .bg video { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0.3; }
  .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--bg) 40%, rgba(14, 26, 28, 0.6) 70%, rgba(14, 26, 28, 0.3) 100%),
      linear-gradient(180deg, rgba(14, 26, 28, 0) 55%, var(--bg) 100%);
  }
  h1 { font-size: var(--t-display); line-height: 1.15; margin: 16px 0 0; max-width: 18ch; }
  .lead { font-size: 19px; color: var(--ink-2); margin: 28px 0 0; }
  .facts { margin: 20px 0 0; padding-left: 1.2em; color: var(--ink-3); font-size: 15px; }
  .facts li + li { margin-top: 4px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 36px 0 0; }
</style>

<script>
  // autoplay 속성 대신 여기서 재생을 시작한다. 움직임을 줄이도록 설정했거나 [data-nomotion]이면
  // 재생하지 않으므로 poster(정지 이미지)만 남고 영상 파일도 내려받지 않는다.
  const video = document.querySelector<HTMLVideoElement>('.hero video');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.hasAttribute('data-nomotion');
  if (video && !still) video.play().catch(() => {});
</script>
