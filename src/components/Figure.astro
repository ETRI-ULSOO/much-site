---
/**
 * 그림 삽입. MDX 본문에서 <Figure src="overview-needs" alt="…" caption="…" />처럼 쓴다.
 *  - src는 src/assets/img/ 안의 파일 이름(확장자 없이). 빌드 때 webp로 바꾸고 폭별 사본을 만든다.
 *  - alt는 반드시 넣는다. 비어 있으면 빌드가 실패한다 (DESIGN.md 7절 규칙 2).
 *  - tone="light": 투명 바탕에 어두운 글자로 그린 도식(발표자료 image6·12)을 밝은 판 위에 얹는다.
 *  - 테두리는 1픽셀 실선 하나, 그림자 없음 (DESIGN.md 3절 규칙 2).
 */
import { Image } from 'astro:assets';
import { findImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  tone?: 'dark' | 'light';
}
const { src, alt, caption, tone = 'dark' } = Astro.props;
if (!alt) throw new Error(`그림 ${src}에 대체 텍스트(alt)가 없습니다`);

const image = await findImage(src);
---

<figure class:list={['figure', tone]}>
  <Image src={image} alt={alt} widths={[640, 1024, 1600]} sizes="(max-width: 720px) 100vw, 720px" loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure { margin: 32px 0; }
  .figure img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  .light img { background: var(--ink); padding: 20px; }
  figcaption { margin-top: 10px; color: var(--ink-3); font-size: 14px; }
</style>
