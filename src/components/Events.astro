---
/** 행사·국제 협력 목록. kind를 주면 그 종류만, 없으면 전부. 순서는 events.yaml 파일 순서다. venue는 있는 항목만 보인다. */
import { getCollection } from 'astro:content';
import { getLocale } from '../i18n/utils';

interface Props {
  kind?: 'colloquium' | 'exhibition' | 'cooperation' | 'international';
}
const { kind } = Astro.props;
const locale = getLocale(Astro.url);

const events = (await getCollection('events')).filter((e) => !kind || e.data.kind === kind);
---

<ol class="events">
  {events.map(({ data }) => {
    const d = data[locale].title ? data[locale] : data.ko;
    return (
      <li>
        <p class="label">{data.date ?? data.year}</p>
        <h3>{d.title}</h3>
        {d.venue && <p class="venue">{d.venue}</p>}
        <p class="desc">{d.desc}</p>
      </li>
    );
  })}
</ol>

<style>
  .events { list-style: none; margin: 0; padding: 0; }
  .events > li { padding: 24px 0 24px 20px; border-left: 1px solid var(--line-strong); }
  .events > li + li { margin-top: 8px; }
  h3 { margin: 8px 0 0; }
  .venue { margin: 6px 0 0; color: var(--ink-3); font-size: 15px; }
  .desc { margin: 10px 0 0; color: var(--ink-2); max-width: 62ch; }
</style>
