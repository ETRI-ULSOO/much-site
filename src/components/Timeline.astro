---
import { getCollection } from 'astro:content';
import { getLocale, useTranslations, localePath } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

// CHIC → MUCH → 후속. 순서는 timeline.yaml의 파일 순서 그대로다.
const items = await getCollection('timeline');
---

<section class="timeline" aria-label={t('timeline.title')}>
  <div class="wrap">
    <p class="label">{t('timeline.title')}</p>
    <ol>
      {items.map(({ data }) => {
        const d = data[locale];
        return (
          <li class:list={[data.status]}>
            <p class="status">{t(`timeline.status.${data.status}`)}</p>
            <h3>{d.name || t('timeline.status.planned')}</h3>
            {d.fullname && <p class="full">{d.fullname}</p>}
            {(data.start || data.end) && (
              <p class="period">{data.start ?? ''} ~ {data.end ?? ''}</p>
            )}
            {d.desc && <p class="desc">{d.desc}</p>}
            <p class="links">
              {data.url && <a href={localePath(locale, data.url)}>{t('timeline.visit')} →</a>}
              {data.external && (
                <a href={data.external} rel="noopener">{t('timeline.external')} ↗</a>
              )}
            </p>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .timeline { padding: var(--section-pad); }
  ol {
    list-style: none; margin: 24px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
    border-top: 1px solid var(--line-strong);
  }
  li { padding: 24px 24px 24px 0; }
  li + li { border-left: 1px solid var(--line); padding-left: 24px; }
  .status { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 12px; }
  .current .status { color: var(--accent); }
  h3 { font-size: clamp(22px, 2.4vw, 30px); margin: 0; }
  .full { color: var(--ink-3); font-size: 15px; margin: 4px 0 0; }
  .period { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; color: var(--ink-muted); margin: 10px 0 0; }
  .desc { color: var(--ink-2); font-size: 15px; margin: 12px 0 0; max-width: 36ch; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; margin: 16px 0 0; font-size: 14px; }
  .links:empty { display: none; }
  /* 후속 과제는 아직 자리만 있다. 잉크를 죽여 '예정'임을 드러낸다. */
  .planned h3, .planned .desc { color: var(--ink-muted); }
  @media (max-width: 720px) {
    ol { grid-template-columns: 1fr; }
    li { padding: 20px 0; }
    li + li { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
  }
</style>
