# ── 빌드 산출물 (Astro) ───────────────────────────────
node_modules/
dist/
.astro/
.vercel/
.netlify/

# ── OS·편집기 ─────────────────────────────────────────
.DS_Store
*.log
.env
.env.*

# ── ⚠️ 대용량 원본 — 절대 커밋 금지 ───────────────────
# 이 저장소는 배포 후 public으로 전환한다.
# 종료평가 발표자료 원본은 7.1 GB이며 GitHub의 파일당 상한 100 MB를 크게 넘는다.
# 발표자료에서 뽑아낸 웹용 이미지만 src/assets/ 아래에 둔다.
docs/참조데이터/

# 영상 원본은 어떤 경로에 있든 커밋하지 않는다.
# 시연 영상은 YouTube에 올리고 저장소에는 영상 ID만 기록한다.
*.mp4
*.mov
*.avi
*.mkv
# 예외: 홈 배경용 무음 클립(6초, 1 MB 미만)만 둔다. 이 폴더에 다른 영상을 넣지 않는다.
!public/video/*.mp4

# 원본 사무 문서도 저장소 밖에 둔다.
*.pptx
*.ppt
